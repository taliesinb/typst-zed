[
	{
		"label": "Typst: Export File",
		"command": "typst",
		"args": ["compile", "\"$ZED_FILE\""],
		"hide": "on_success"
	},
	{
		"label": "Typst: Export File (Dark)",
		"command": "typst",
		"args": [
			"compile",
			"--input", "theme=dark",
			"--input", "dark-mode=true",
			"\"$ZED_FILE\"",
			"\"$ZED_DIRNAME/$ZED_STEM-dark.pdf\""
		],
		"hide": "on_success"
	},
	{
		"label": "Typst: Watch File",
		"command": "typst",
		"args": ["watch", "\"$ZED_FILE\""],
		"reveal": "never",
		"hide": "always"
	},
	{
		"label": "Typst: Watch File (Dark)",
		"command": "typst",
		"args": [
			"watch",
			"--input", "theme=dark",
			"--input", "dark-mode=true",
			"\"$ZED_FILE\"",
			"\"$ZED_DIRNAME/$ZED_STEM-dark.pdf\""
		],
		"reveal": "never",
		"hide": "always"
	},
	{
		"label": "Typst: Open Preview (Dark)",
		"command": "url=\"http://$(cat \"$HOME/Library/Caches/tinymist/preview/$(printf %s \"$ZED_WORKTREE_ROOT\" | tr / _).addr\" 2>/dev/null || echo 127.0.0.1:23635)/\"; open -a Typst \"$url\" 2>/dev/null || open \"$url\"",
		"reveal": "never",
		"hide": "always",
		"tags": ["typst-preview"]
	},
	{
		"label": "Typst: Open Preview (Light)",
		"command": "/Users/tali/github/tinymist/target/release/tinymist",
		"args": [
			"preview",
			"--data-plane-host=127.0.0.1:0",
			"--open-in", "Typst",
			"--invert-colors=never",
			"--root", "\"$ZED_WORKTREE_ROOT\"",
			"--open",
			"\"$ZED_FILE\""
		],
		"reveal": "never",
		"hide": "always"
	}
]
